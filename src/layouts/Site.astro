---
// 首頁與導讀頁共用的版型（查詢版仍用 Starlight 版型）
import '../styles/site.css';
import { MOE_DOWNLOAD, MOE_NAME } from '../data/moe';

interface Props {
	title: string;
	description?: string;
	current?: 'home' | 'read' | 'library' | 'search';
}
const { title, description, current } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const siteName = 'AI 素養資源站';
const fullTitle = title === siteName ? siteName : `${title}｜${siteName}`;
const desc =
	description ?? '教育部數位學習推動辦公室 AI 素養相關文件的導讀與全文查詢：AI 素養框架、教學指引、教案示例、學習應用手冊與行政文件。';
const nav = [
	{ key: 'read', href: `${base}/read/`, label: '導讀', en: 'Read' },
	{ key: 'library', href: `${base}/library/`, label: '資料庫', en: 'Library' },
];
---

<!doctype html>
<html lang="zh-TW">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{fullTitle}</title>
		<meta name="description" content={desc} />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={desc} />
		<link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700&family=Noto+Serif+TC:wght@600;700;900&family=Outfit:wght@300;500;700&display=swap"
		/>
		<script is:inline>
			// 只有 JS 能執行時才先把進場元素藏起來，避免沒有 JS 時一片空白
			document.documentElement.setAttribute('data-reveal', '');
		</script>
	</head>
	<body class="site">
		<a class="skip" href="#main">跳到主要內容</a>
		<header class="site-header">
			<div class="wrap">
				<a class="logo" href={`${base}/`} aria-label={`${siteName} 首頁`}>
					<span class="logo-mark">AI</span>
					<span class="logo-text">AI 素養資源站</span>
				</a>
				<nav class="nav" aria-label="主要">
					{
						nav.map((n) => (
							<a href={n.href} aria-current={current === n.key ? 'page' : undefined}>
								<small>{n.en}</small>
								{n.label}
							</a>
						))
					}
					<a class="nav-search" href={`${base}/search/`} aria-label="搜尋全站" aria-current={current === 'search' ? 'page' : undefined}>
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"
							><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg
						>
					</a>
				</nav>
			</div>
		</header>

		<main id="main">
			<slot />
		</main>

		<footer class="site-footer">
			<div class="wrap">
				<div class="footer-grid">
					<div>
						<p class="footer-big">讀懂它，<br />也找得到它。</p>
					</div>
					<div>
						<p class="eyebrow" style="color:#a9a295">Navigation</p>
						<p>
							<a href={`${base}/read/`}>導讀：互動閱讀</a><br />
							<a href={`${base}/library/`}>資料庫：全文與查詢</a><br />
							<a href={`${base}/search/`}>搜尋全站</a>
						</p>
					</div>
					<div>
						<p class="eyebrow" style="color:#a9a295">Source</p>
						<p>
							所有內容出自{MOE_NAME}公開文件。原始 PDF 請至
							<a href={MOE_DOWNLOAD} rel="noopener" target="_blank">教育部下載專區（另開新視窗）</a>下載。
						</p>
					</div>
				</div>
				<p class="footer-credit">
					資料來源：<a href={MOE_DOWNLOAD} rel="noopener" target="_blank">{MOE_NAME}</a>。本站將公開 PDF 轉為網頁以便閱讀與搜尋，內容以教育部原文為準。
				</p>
			</div>
		</footer>

		<script>
			// 捲到才進場；同一組元素依序出現（--i）
			const io = new IntersectionObserver(
				(entries) => {
					for (const e of entries) {
						if (e.isIntersecting) {
							e.target.classList.add('is-in');
							io.unobserve(e.target);
						}
					}
				},
				{ rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
			);
			document.querySelectorAll('.reveal, .reveal-left, .reveal-right, [data-observe]').forEach((el) => io.observe(el));

			const header = document.querySelector('.site-header');
			const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 8);
			addEventListener('scroll', onScroll, { passive: true });
			onScroll();
		</script>
	</body>
</html>
