---
// 紅筆圈：老師圈重點的手繪橢圓。draw = 進場時畫出來（只用在首頁標題）
interface Props {
	draw?: boolean;
	delay?: string;
}
const { draw = false, delay } = Astro.props;
---

<span class:list={['ring', { draw }]} style={delay ? `--d:${delay}` : undefined}
	><slot /><svg viewBox="0 0 100 40" preserveAspectRatio="none" aria-hidden="true"
		><path pathLength="1" d="M10 25 C8 9 52 3 84 8 C99 11 99 31 74 36 C47 41 6 37 3 23 C1 13 18 6 38 5"></path></svg
	></span
>
