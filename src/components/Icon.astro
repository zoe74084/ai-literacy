---
// 少量手繪風圖示，統一 1.8 粗細、圓角筆觸
interface Props {
	name: 'external' | 'search' | 'book' | 'lens' | 'check' | 'download';
	class?: string;
	label?: string;
}
const { name, class: cls, label } = Astro.props;
const paths: Record<Props['name'], string> = {
	external: '<path d="M14 4h6v6"/><path d="M20 4 11 13"/><path d="M19 14v4a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h4"/>',
	search: '<circle cx="11" cy="11" r="6.5"/><path d="m20 20-4.2-4.2"/>',
	book: '<path d="M3 5.5C6 4 9 4 12 6c3-2 6-2 9-.5V19c-3-1.5-6-1.5-9 .5-3-2-6-2-9-.5Z"/><path d="M12 6v13.5"/>',
	lens: '<circle cx="10" cy="10" r="6"/><path d="m19 19-4.6-4.6"/><path d="M7.5 9h5M7.5 11.5h3.5"/>',
	check: '<path d="m5 12.5 4.5 4.5L19 7"/>',
	download: '<path d="M12 4v11"/><path d="m7 10 5 5 5-5"/><path d="M5 20h14"/>',
};
---

<svg
	class:list={['icon', cls]}
	viewBox="0 0 24 24"
	width="1em"
	height="1em"
	fill="none"
	stroke="currentColor"
	stroke-width="1.8"
	stroke-linecap="round"
	stroke-linejoin="round"
	role={label ? 'img' : undefined}
	aria-label={label}
	aria-hidden={label ? undefined : 'true'}
	set:html={paths[name]}
/>
