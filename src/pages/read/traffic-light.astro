---
import Site from '../../layouts/Site.astro';
import ReadMeta from '../../components/read/ReadMeta.astro';
import { readBody, sections, parseTable, cell, plain } from '../../lib/content';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const SLUG = 'guides/teacher/04';
const body = readBody(SLUG);

// 表 3-1：教師教學使用 AI 判斷原則參考
const tableLines: string[] = [];
{
	const lines = body.split('\n');
	const start = lines.findIndex((l) => l.includes('燈號'));
	if (start >= 0) {
		let s = start;
		while (s > 0 && lines[s - 1].trim().startsWith('|')) s--;
		for (let i = s; i < lines.length && lines[i].trim().startsWith('|'); i++) tableLines.push(lines[i]);
	}
}
const rows = parseTable(tableLines)
	.map((r) => r.map(cell))
	.filter((r) => /燈/.test(r[1] ?? '') && !/燈號/.test(r[1]));
const lightOf = (s: string) => (s.includes('紅') ? 'red' : s.includes('黃') ? 'yellow' : 'green');
const modes = rows.map((r) => ({ name: r[0], light: lightOf(r[1]), purpose: r[2], teacher: r[3], student: r[4] }));

// 班級公約的三個燈區
const { sections: secs } = sections(body);
function zone(re: RegExp) {
	const s = secs.find((x) => re.test(x.title));
	if (!s) return null;
	const lines = s.body.split('\n').filter((l) => l.trim());
	const purpose = plain(lines.find((l) => l.startsWith('目的')) ?? '').replace(/^目的：/, '');
	const text = lines.filter((l) => !l.startsWith('目的')).join('');
	// 「腦力激盪：……。概念解釋：……。」→ 一條一條
	const items = text
		.split(/(?<=。)/)
		.map((t) => t.trim())
		.filter(Boolean)
		.map((t) => {
			const i = t.indexOf('：');
			return i > 0 && i < 12 ? { label: t.slice(0, i), text: t.slice(i + 1) } : { label: '', text: t };
		});
	return { title: s.title, purpose, items };
}
const zones = { green: zone(/^綠燈區/), yellow: zone(/^黃燈區/), red: zone(/^紅燈區/) };

// 教師自我檢核
const checkSec = secs.find((x) => /判斷面向與自我檢核/.test(x.title));
const checks = checkSec ? parseTable(checkSec.body.split('\n')).slice(1).map((r) => ({ aspect: cell(r[0]), q: cell(r[1]) })) : [];
const checkLead = checkSec?.body.split('\n').find((l) => l.trim() && !l.trim().startsWith('|'))?.trim() ?? '';

// 公約承諾、學習承諾
const promise = (secs.find((x) => /^我們承諾/.test(x.title))?.body ?? '')
	.split('\n')
	.map((l) => plain(l.replace(/^- /, '')))
	.filter((l) => /^\d+\./.test(l));
const learn = (secs.find((x) => /^學習承諾/.test(x.title))?.body ?? '')
	.split('\n')
	.map((l) => plain(l))
	.filter((l) => /^\d+\./.test(l));
const lead = body.split('\n').find((l) => l.includes('從不使用（紅燈）'))?.trim() ?? '';

const LIGHTS = [
	{ key: 'red', label: '紅燈', sub: '不使用 AI' },
	{ key: 'yellow', label: '黃燈', sub: '有條件使用' },
	{ key: 'green', label: '綠燈', sub: '全開放使用' },
] as const;
---

<Site title="課堂 AI 紅黃綠燈" description="教師依學習目標決定課堂中使用 AI 的程度：紅燈、黃燈、綠燈。" current="read">
	<section class="page-hero wrap tl-hero">
		<h1>課堂 AI<br />紅黃綠燈</h1>
		<p class="lead" style="--i:2">{lead}</p>
		<ReadMeta file="04_教學指引_115年中小學教師數位與AI教學指引1150920.md" full={`${SLUG}/`} />
	</section>

	<section class="band band--cover tl-band" data-tl>
		<div class="wrap tl-grid">
			<div class="signal" role="group" aria-label="選擇燈號">
				<div class="signal-body">
					{
						LIGHTS.map((l, i) => (
							<button type="button" class={`lamp lamp--${l.key}`} data-light={l.key} aria-pressed={i === 0 ? 'true' : 'false'}>
								<span class="lamp-glow" />
								<span class="lamp-text">
									<b>{l.label}</b>
									<small>{l.sub}</small>
								</span>
							</button>
						))
					}
				</div>
				<span class="pole" aria-hidden="true" />
				<p class="signal-hint">點一盞燈</p>
			</div>

			<div class="tl-panels">
				{
					LIGHTS.map((l, i) => {
						const z = zones[l.key];
						return (
							<div class={`tl-panel tl-panel--${l.key}`} data-panel={l.key} hidden={i !== 0}>
								{modes
									.filter((m) => m.light === l.key)
									.map((m) => (
										<article class="mode">
											<h2>
												<span class={`dot dot--${l.key}`} />
												{m.name}
											</h2>
											<dl>
												<div>
													<dt>適用的教學目的</dt>
													<dd>{m.purpose}</dd>
												</div>
												<div>
													<dt>教師教學設計原則</dt>
													<dd>{m.teacher}</dd>
												</div>
												<div>
													<dt>學生使用規範與標記</dt>
													<dd>{m.student}</dd>
												</div>
											</dl>
										</article>
									))}
								{z && (
									<article class="zone">
										<h3>{z.title}</h3>
										{z.purpose && <p class="zone-purpose">目的：{z.purpose}</p>}
										<ul>
											{z.items.map((it) => (
												<li>
													{it.label && <b>{it.label}</b>}
													{it.text}
												</li>
											))}
										</ul>
									</article>
								)}
							</div>
						);
					})
				}
			</div>
		</div>
	</section>

	{
		checks.length > 0 && (
			<section class="band band--tint">
				<div class="wrap-narrow">
					<div class="section-head">
						<h2>選擇燈號前的自我檢核</h2>
						<p>{checkLead}</p>
					</div>
					<ol class="checks" data-checks>
						{checks.map((c, i) => (
							<li style={`--i:${i % 4}`}>
								<label>
									<input type="checkbox" />
									<span class="check-box" aria-hidden="true">
										✓
									</span>
									<span>
										<b>{c.aspect}</b>
										{c.q}
									</span>
								</label>
							</li>
						))}
					</ol>
					<p class="check-count" aria-live="polite">
						已想過 <b data-checked>0</b> / {checks.length} 個面向
					</p>
				</div>
			</section>
		)
	}

	<section class="band">
		<div class="wrap pledge">
			{
				promise.length > 0 && (
					<div class="pledge-card">
						<h2>我們承諾</h2>
						<ol>{promise.map((p) => <li>{p.replace(/^\d+\.\s*/, '')}</li>)}</ol>
					</div>
				)
			}
			{
				learn.length > 0 && (
					<div class="pledge-card pledge-card--2">
						<h2>學習承諾</h2>
						<ol>{learn.map((p) => <li>{p.replace(/^\d+\.\s*/, '')}</li>)}</ol>
					</div>
				)
			}
		</div>
		<p class="wrap more">
			<a class="btn" href={`${base}/read/doc/${SLUG}/`}>讀第三章全文</a>
		</p>
	</section>
</Site>

<script>
	const root = document.querySelector<HTMLElement>('[data-tl]');
	if (root) {
		const lamps = [...root.querySelectorAll<HTMLButtonElement>('[data-light]')];
		lamps.forEach((b) =>
			b.addEventListener('click', () => {
				lamps.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
				root.querySelectorAll<HTMLElement>('[data-panel]').forEach((p) => {
					const on = p.dataset.panel === b.dataset.light;
					p.hidden = !on;
					if (on) {
						p.classList.remove('is-shown');
						void p.offsetWidth;
						p.classList.add('is-shown');
					}
				});
			}),
		);
	}
	const checks = document.querySelector('[data-checks]');
	const out = document.querySelector('[data-checked]');
	checks?.addEventListener('change', () => {
		if (out) out.textContent = String(checks.querySelectorAll('input:checked').length);
	});
</script>

<style>
	.tl-band {
		color: #ece6da;
	}
	.tl-grid {
		display: grid;
		grid-template-columns: 11rem minmax(0, 1fr);
		gap: clamp(1.5rem, 5vw, 4rem);
		align-items: start;
	}
	.signal {
		position: sticky;
		top: 6rem;
		display: grid;
		justify-items: center;
	}
	.signal-body {
		display: grid;
		gap: 0.9rem;
		padding: 1rem;
		background: #15171b;
		border-radius: 3rem;
		border: 2px solid #4a4f57;
		box-shadow: inset 0 0 0 6px #1d2026;
	}
	.pole {
		width: 0.8rem;
		height: 5rem;
		background: #4a4f57;
	}
	.signal-hint {
		margin: 0.5rem 0 0;
		font-size: 0.8rem;
		color: #a9a295;
	}
	.lamp {
		--on: #555;
		position: relative;
		display: grid;
		place-items: center;
		width: 7rem;
		aspect-ratio: 1;
		border-radius: 50%;
		border: 0;
		background: #2a2d33;
		color: #8b8f96;
		cursor: pointer;
		font: inherit;
		transition:
			background 0.35s,
			color 0.35s,
			transform 0.25s var(--ease-out);
	}
	.lamp:hover {
		transform: scale(1.04);
	}
	.lamp--red { --on: #e2513b; }
	.lamp--yellow { --on: #f2b83d; }
	.lamp--green { --on: #4fb46a; }
	.lamp[aria-pressed='true'] {
		background: var(--on);
		color: #1b1d21;
	}
	.lamp-glow {
		position: absolute;
		inset: -14px;
		border-radius: 50%;
		background: radial-gradient(circle, color-mix(in srgb, var(--on) 55%, transparent), transparent 70%);
		opacity: 0;
		transition: opacity 0.4s;
		pointer-events: none;
	}
	.lamp[aria-pressed='true'] .lamp-glow {
		opacity: 1;
	}
	@media (prefers-reduced-motion: no-preference) {
		.lamp[aria-pressed='true'] .lamp-glow {
			animation: pulse 2.4s ease-in-out infinite;
		}
	}
	@keyframes pulse {
		50% {
			transform: scale(1.12);
			opacity: 0.6;
		}
	}
	.lamp-text {
		position: relative;
		display: grid;
		line-height: 1.3;
		text-align: center;
	}
	.lamp-text b {
		font-family: var(--kai);
		font-size: 1.3rem;
	}
	.lamp-text small {
		font-size: 0.72rem;
	}

	.tl-panel {
		display: grid;
		gap: 1rem;
	}
	.tl-panel .eyebrow {
		color: #a9a295;
	}
	@media (prefers-reduced-motion: no-preference) {
		.tl-panel.is-shown > * {
			animation: rise 0.55s var(--ease-out) backwards;
		}
		.tl-panel.is-shown > *:nth-child(3) {
			animation-delay: 0.08s;
		}
		.tl-panel.is-shown > *:nth-child(4) {
			animation-delay: 0.16s;
		}
	}
	@keyframes rise {
		from {
			opacity: 0;
			transform: translateY(18px);
		}
	}
	.mode,
	.zone {
		background: var(--paper);
		color: var(--ink);
		border-radius: var(--r-lg);
		padding: clamp(1.2rem, 3vw, 1.75rem);
	}
	.mode h2 {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		font-size: 1.4rem;
		margin-bottom: 1rem;
	}
	.dot {
		width: 1rem;
		height: 1rem;
		border-radius: 50%;
	}
	.dot--red { background: #e2513b; }
	.dot--yellow { background: #f2b83d; }
	.dot--green { background: #4fb46a; }
	.mode dl {
		margin: 0;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1rem;
	}
	.mode dt {
		font-size: 0.78rem;
		font-weight: 700;
		color: var(--ink-3);
		margin-bottom: 0.3rem;
	}
	.mode dd {
		margin: 0;
		font-size: 0.95rem;
		line-height: 1.75;
	}
	@media (max-width: 52rem) {
		.mode dl {
			grid-template-columns: 1fr;
		}
	}
	.zone {
		background: var(--paper);
		border: 2px dashed var(--ink-3);
	}
	.zone h3 {
		font-size: 1.25rem;
		margin: 0.3rem 0 0.5rem;
	}
	.zone-purpose {
		font-family: var(--kai);
		font-weight: 600;
	}
	.zone ul {
		margin: 0;
		padding-left: 1.1rem;
		display: grid;
		gap: 0.5rem;
	}
	.zone b {
		margin-right: 0.4rem;
		background: linear-gradient(transparent 60%, var(--chalk) 60%);
	}
	@media (max-width: 44rem) {
		.tl-grid {
			grid-template-columns: 1fr;
		}
		.signal {
			position: static;
		}
		.signal-body {
			grid-auto-flow: column;
			border-radius: 3rem;
		}
		.lamp {
			width: 5.4rem;
		}
		.pole {
			display: none;
		}
	}

	.checks {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		gap: 0.6rem;
	}
	.checks label {
		display: flex;
		gap: 0.9rem;
		align-items: flex-start;
		padding: 1rem 1.2rem;
		background: var(--paper);
		border-radius: 1rem;
		border: 1.5px solid var(--line);
		cursor: pointer;
		transition: border-color 0.2s;
	}
	.checks label:has(input:checked) {
		border-color: var(--c-teacher);
		background: var(--c-teacher-soft);
	}
	.checks input {
		position: absolute;
		opacity: 0;
	}
	.checks label:has(input:focus-visible) {
		outline: 2.5px solid var(--blue-pen);
	}
	.check-box {
		flex: none;
		display: grid;
		place-items: center;
		width: 1.6rem;
		height: 1.6rem;
		border-radius: 0.5rem;
		border: 1px solid var(--line);
		color: transparent;
		font-weight: 700;
		transition:
			background 0.2s,
			color 0.2s,
			transform 0.25s var(--ease-out);
	}
	.checks input:checked + .check-box {
		background: var(--c-teacher);
		color: var(--paper);
		border-color: var(--c-teacher);
		transform: rotate(-8deg) scale(1.08);
	}
	.checks b {
		display: block;
		font-family: var(--kai);
	}
	.check-count {
		margin-top: 1.25rem;
		font-size: 0.95rem;
	}
	.check-count b {
		font-family: var(--sans);
		font-size: 1.6rem;
		font-weight: 300;
	}

	.pledge {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: clamp(1rem, 3vw, 2rem);
	}
	.pledge-card {
		padding: clamp(1.5rem, 4vw, 2.5rem);
		border-radius: var(--r-lg);
		border: 1px solid var(--line);
		background: var(--paper-deep);
	}
	.pledge-card--2 {
		background: var(--c-student-soft);
	}
	.pledge-card h2 {
		font-size: 1.6rem;
		margin: 0.5rem 0 1rem;
	}
	.pledge-card ol {
		margin: 0;
		padding-left: 1.3rem;
		display: grid;
		gap: 0.5rem;
		font-family: var(--kai);
	}
	.more {
		margin-top: 2.5rem;
	}
	@media (max-width: 44rem) {
		.pledge {
			grid-template-columns: 1fr;
		}
	}
</style>
