---
import Site from '../../layouts/Site.astro';
import { catalog } from '../../lib/content';
import { AUDIENCE_LABELS } from '../../data/audiences';
import { moeFor } from '../../data/moe';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const r = (p: string) => `${base}/read/${p}`;

const features = [
	{ n: '01', t: 'AI 素養框架', d: '切換教師／學生，沿著三層階梯看每個面向的目標與內涵。', h: r('framework/'), c: 'kusa', icon: '▦' },
	{ n: '02', t: '生成式 AI 注意事項', d: '學生版、大人版，一張卡片一個重點，可以翻頁閱讀。', h: r('notices/'), c: 'sora', icon: '❏' },
	{ n: '03', t: '課堂 AI 紅黃綠燈', d: '依學習目標決定 AI 使用程度，點燈號看規範。', h: r('traffic-light/'), c: 'shu', icon: '●' },
	{ n: '04', t: '指引重點先看', d: '教師、校長指引每章開頭的重點；家長指引各章一覽。', h: r('guides/'), c: 'yamabuki', icon: '✎' },
	{ n: '05', t: '教案地圖', d: '學段 × 領域的地圖，點格子看課例。', h: r('lessons/'), c: 'fuji', icon: '⌗' },
];

const SHELVES = [
	{ id: 'framework', title: 'AI 素養框架', groups: ['framework'] },
	{ id: 'notices', title: '使用生成式 AI 注意事項', groups: ['notices'] },
	{ id: 'guides', title: '數位與 AI 教學指引（115 年）', groups: ['guides'] },
	{ id: 'handbooks', title: 'AI 學習應用手冊', groups: ['handbooks'] },
	{ id: 'lessons', title: '教案示例', groups: ['lessons-es', 'lessons-jh', 'lessons-sh', 'lessons-vs'] },
	{ id: 'parents', title: '家長宣導', groups: ['parents'] },
	{ id: 'admin', title: '行政：實施計畫與教育大數據', groups: ['admin-plan', 'admin-data'] },
	{ id: 'ark', title: 'AI 人才方舟計畫', groups: ['ark'] },
	{ id: 'history', title: '歷史版本（114 年指引）', groups: ['history'] },
].map((s) => ({
	...s,
	docs: catalog
		.filter((d) => s.groups.includes(d.group))
		.sort((a, b) => (a.lesson && b.lesson ? a.lesson.stageOrder - b.lesson.stageOrder || a.lesson.number - b.lesson.number : a.order - b.order)),
}));
---

<Site title="導讀" description="AI 素養相關文件的互動導讀與閱讀版。" current="read">
	<section class="page-hero wrap read-hero">
		<span class="eyebrow reveal">Read</span>
		<h1 class="reveal" style="--i:1">把文件<span class="mark">變成可以讀的頁面</span></h1>
		<p class="lead reveal" style="--i:2">
			先從五個互動導讀開始，或在下面的書架挑一份文件直接閱讀。內容都是教育部原文，只是換了一種排版與讀法；原始 PDF 一律連回教育部下載。
		</p>
		<span class="read-tate tate" aria-hidden="true">讀懂再查</span>
	</section>

	<section class="wrap features">
		{
			features.map((f, i) => (
				<a class={`feature feature--${f.c} reveal`} style={`--i:${i}`} href={f.h}>
					<span class="feature-icon" aria-hidden="true">
						{f.icon}
					</span>
					<span class="num">{f.n}</span>
					<h2>{f.t}</h2>
					<p>{f.d}</p>
					<span class="feature-go" aria-hidden="true">
						→
					</span>
				</a>
			))
		}
	</section>

	<section class="band band--paper2 band--arch" id="shelf" data-shelf>
		<div class="wrap">
			<div class="section-head reveal">
				<span class="eyebrow">Bookshelf</span>
				<h2>書架：所有文件</h2>
				<p>選讀者類型可以只看相關的文件。</p>
			</div>
			<div class="filter reveal" role="group" aria-label="依讀者篩選">
				<button type="button" data-aud="" aria-pressed="true">全部</button>
				{
					Object.entries(AUDIENCE_LABELS).map(([k, v]) => (
						<button type="button" data-aud={k} aria-pressed="false" class={`f-${k}`}>
							{v}
						</button>
					))
				}
			</div>

			{
				SHELVES.map((s) => (
					<section class="shelf-row" id={s.id} data-row>
						<h3 class="shelf-title">
							{s.title}
							<span class="shelf-count">{s.docs.length}</span>
						</h3>
						<ul class="shelf-docs">
							{s.docs.map((d) => (
								<li data-aud={d.audience.join(' ')}>
									<a class="doc" href={r(`doc/${d.slug}/`)}>
										{d.lesson && (
											<span class="doc-tags">
												<span class="chip chip--student">{d.lesson.stage}</span>
												<span class="chip">{d.lesson.domain}</span>
											</span>
										)}
										<span class="doc-title">{d.title}</span>
										<span class="doc-meta">
											{d.chapters ? `${d.chapters.length} 章` : '單頁'}
											{d.audience.length < 4 && ` · ${d.audience.map((a) => AUDIENCE_LABELS[a]).join('、')}`}
										</span>
									</a>
									<a class="moe-link doc-moe" href={moeFor(d.file).url} target="_blank" rel="noopener" title="到教育部下載專區下載原始 PDF">
										原文 ↗
									</a>
								</li>
							))}
						</ul>
					</section>
				))
			}
		</div>
	</section>
</Site>

<script>
	const root = document.querySelector('[data-shelf]');
	if (root) {
		const btns = [...root.querySelectorAll<HTMLButtonElement>('[data-aud]')].filter((b) => b.tagName === 'BUTTON');
		const apply = (aud: string) => {
			btns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.aud === aud)));
			root.querySelectorAll<HTMLElement>('[data-row]').forEach((row) => {
				let shown = 0;
				row.querySelectorAll<HTMLLIElement>('li[data-aud]').forEach((li) => {
					const ok = !aud || li.dataset.aud!.split(' ').includes(aud);
					li.hidden = !ok;
					if (ok) shown++;
				});
				row.hidden = shown === 0;
			});
		};
		btns.forEach((b) => b.addEventListener('click', () => apply(b.dataset.aud!)));
		const q = new URLSearchParams(location.search).get('aud');
		if (q) apply(q);
	}
</script>

<style>
	.read-hero {
		position: relative;
	}
	.read-tate {
		position: absolute;
		right: var(--gutter);
		top: clamp(2.5rem, 7vw, 5rem);
		font-family: var(--serif);
		font-weight: 900;
		font-size: clamp(1.5rem, 4vw, 3rem);
		color: var(--paper-3);
		margin: 0;
	}
	@media (max-width: 40rem) {
		.read-tate {
			display: none;
		}
	}
	.features {
		display: grid;
		grid-template-columns: repeat(6, 1fr);
		gap: 1rem;
		padding-bottom: clamp(4rem, 9vw, 6rem);
	}
	.feature {
		grid-column: span 2;
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		padding: 1.5rem 1.5rem 3.25rem;
		border-radius: 1.75rem;
		border: 1.5px solid var(--ink);
		background: var(--c);
		text-decoration: none;
		overflow: hidden;
		min-height: 15rem;
		transition:
			transform 0.3s var(--ease),
			box-shadow 0.3s var(--ease);
	}
	.feature:nth-child(4),
	.feature:nth-child(5) {
		grid-column: span 3;
	}
	.feature:hover {
		transform: translateY(-5px) rotate(-0.6deg);
		box-shadow: 6px 8px 0 var(--ink);
	}
	.feature--kusa { --c: var(--kusa-soft); }
	.feature--sora { --c: var(--sora-soft); }
	.feature--shu { --c: var(--shu-soft); }
	.feature--yamabuki { --c: var(--yamabuki-soft); }
	.feature--fuji { --c: var(--fuji-soft); }
	.feature-icon {
		position: absolute;
		right: 1rem;
		top: 0.25rem;
		font-size: 5rem;
		line-height: 1;
		opacity: 0.12;
	}
	.feature .num {
		font-size: 2.8rem;
		-webkit-text-stroke-color: var(--ink);
	}
	.feature h2 {
		font-size: 1.35rem;
	}
	.feature p {
		color: var(--ink-2);
		font-size: 0.92rem;
		margin: 0;
	}
	.feature-go {
		position: absolute;
		right: 1.25rem;
		bottom: 1.1rem;
		display: grid;
		place-items: center;
		width: 2.4rem;
		height: 2.4rem;
		border-radius: 50%;
		background: var(--ink);
		color: var(--white);
		transition: transform 0.3s var(--bounce);
	}
	.feature:hover .feature-go {
		transform: translateX(4px) scale(1.1);
	}
	@media (max-width: 56rem) {
		.features {
			grid-template-columns: 1fr 1fr;
		}
		.feature,
		.feature:nth-child(4),
		.feature:nth-child(5) {
			grid-column: span 1;
		}
	}
	@media (max-width: 34rem) {
		.features {
			grid-template-columns: 1fr;
		}
		.feature {
			min-height: 0;
		}
	}

	.filter {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-bottom: 2rem;
	}
	.filter button {
		font: inherit;
		font-weight: 500;
		padding: 0.4rem 1.1rem;
		border-radius: 999px;
		border: 1.5px solid var(--ink);
		background: var(--white);
		cursor: pointer;
		transition: transform 0.2s var(--ease);
	}
	.filter button:hover {
		transform: translateY(-2px);
	}
	.filter button[aria-pressed='true'] {
		background: var(--ink);
		color: var(--white);
	}
	.filter .f-teacher[aria-pressed='true'] { background: var(--kusa); border-color: var(--kusa); }
	.filter .f-student[aria-pressed='true'] { background: var(--sora); border-color: var(--sora); }
	.filter .f-parent[aria-pressed='true'] { background: var(--shu); border-color: var(--shu); }
	.filter .f-admin[aria-pressed='true'] { background: var(--fuji); border-color: var(--fuji); }

	.shelf-row {
		margin-bottom: 2.5rem;
	}
	.shelf-title {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		font-size: 1.2rem;
		padding-bottom: 0.6rem;
		margin-bottom: 1rem;
		border-bottom: 1.5px solid var(--ink);
	}
	.shelf-count {
		font-family: var(--latin);
		font-size: 0.8rem;
		font-weight: 500;
		padding: 0 0.6rem;
		border-radius: 999px;
		background: var(--ink);
		color: var(--white);
	}
	.shelf-docs {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
		gap: 0.75rem;
	}
	.shelf-docs li {
		position: relative;
	}
	.doc {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		height: 100%;
		padding: 1rem 1.1rem 2.2rem;
		background: var(--white);
		border-radius: 1rem;
		border: 1px solid var(--line);
		text-decoration: none;
		transition:
			border-color 0.2s,
			transform 0.25s var(--ease);
	}
	.doc:hover {
		border-color: var(--ink);
		transform: translateY(-3px);
	}
	.doc-tags {
		display: flex;
		gap: 0.3rem;
	}
	.doc-title {
		font-family: var(--serif);
		font-weight: 700;
		line-height: 1.5;
	}
	.doc-meta {
		font-size: 0.78rem;
		color: var(--ink-3);
	}
	.doc-moe {
		position: absolute;
		right: 1rem;
		bottom: 0.7rem;
		font-size: 0.75rem;
	}
</style>
